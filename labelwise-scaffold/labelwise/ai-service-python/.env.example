[TEMPLATE]
# Which LLM explains results: "ollama" (local, default) or "openai"
# (any OpenAI-compatible API: OpenAI, Groq, OpenRouter, DeepSeek, ...).
LLM_PROVIDER=ollama

# --- LLM_PROVIDER=ollama (defaults shown; no API key needed) ---
# Requires a local Ollama install: `ollama serve` + `ollama pull llama3.2`
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# --- LLM_PROVIDER=openai (hosted, requires OPENAI_API_KEY) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Any OpenAI-compatible endpoint works, e.g.
#   OpenAI     https://api.openai.com/v1
#   Groq       https://api.groq.com/openai/v1
#   OpenRouter https://openrouter.ai/api/v1
#   DeepSeek   https://api.deepseek.com/v1
OPENAI_BASE_URL=https://api.openai.com/v1
