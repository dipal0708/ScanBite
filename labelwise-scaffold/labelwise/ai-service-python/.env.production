# Python AI Service Environment Variables
# Set these in your hosting platform's dashboard (Render/Railway/Fly.io)

# Choose your LLM provider: "ollama" (local) or "openai" (hosted)
LLM_PROVIDER=ollama

# --- Ollama (local, no API key needed) ---
# Requires Ollama running on the server OR use a managed Ollama service
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# --- OpenAI-compatible (any provider, requires API key) ---
# Uncomment and configure for hosted LLM:
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# Examples for other providers:
# Groq: OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OpenRouter: OPENAI_BASE_URL=https://openrouter.ai/api/v1
# DeepSeek: OPENAI_BASE_URL=https://api.deepseek.com/v1
